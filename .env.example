# HELIOS local settings template (step 023)
# Copy this file to .env and set your own password:   cp .env.example .env
# .env is gitignored. Never commit real passwords.

# PostgreSQL (Docker container "helios-postgres")
POSTGRES_USER=helios
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helios
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Adminer web UI: http://localhost:8080
ADMINER_PORT=8080
